{
  "name": "stop-bite",
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --ext js,html,css --exec electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:win": "electron-builder --win portable --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.stopbite.app",
    "productName": "StopBite",
    "files": [
      "**/*",
      "!node_modules/electron-builder${/*}",
      "!node_modules/nodemon${/*}"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "electron-store": "^11.0.2"
  }
}
